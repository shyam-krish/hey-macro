// Copy this file to Secrets.xcconfig (same folder, gitignored) and fill in real values.
// NOTE: xcconfig treats "//" as a comment start — values must not contain "//".
// API keys don't; never put URLs in here.

OPENAI_API_KEY = sk-your-openai-key
GEMINI_API_KEY = your-gemini-key

// One of: openai | gemini | gemini3
LLM_PROVIDER = openai

// Apple Team ID — only needed for physical-device builds and App Store archives.
DEVELOPMENT_TEAM =
